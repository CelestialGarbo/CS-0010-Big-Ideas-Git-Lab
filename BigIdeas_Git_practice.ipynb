    "sentence = input(\"Type in a sentence\")\n",
    "wants_upper = (input(\"Type True for all uppercase, Type False for all lowercase\"))\n",
    "\n",
    "if(wants_upper == \"True\"):\n",
    "    newSentence = sentence.upper()\n",
    "    print(newSentence)\n",
    "else:\n",
    "    newerSentence = sentence.lower()\n",
    "    print(newerSentence)"
